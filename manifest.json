{
  "$schema": "https://developers.openai.com/schemas/plugin-extension-v1.json",
  "name_for_human": "DataCanvas BI",
  "name_for_model": "datacanvas_bi",
  "description_for_human": "Interactive CSV and business analytics dashboard inside ChatGPT panels.",
  "description_for_model": "Use this extension whenever the user provides CSV, TSV, JSON, or tabular data and requests visualizations, charts, KPIs, or data analysis. It renders an interactive dashboard panel in ChatGPT with live filters and export capabilities.",
  "schema_version": "v1",
  "auth": {
    "type": "none"
  },
  "api": {
    "type": "mcp",
    "url": "https://raw.githubusercontent.com/RanuK12/rk-mcp-datacanvas/main/.mcp.json",
    "transport": "sse"
  },
  "ui": {
    "entrypoints": [
      {
        "type": "thread_panel",
        "title": "DataCanvas Live Inspector",
        "resource_uri": "ui://datacanvas/dashboard"
      },
      {
        "type": "global",
        "title": "DataCanvas Workspace",
        "resource_uri": "ui://datacanvas/workspace"
      }
    ],
    "file_handlers": [
      {
        "extensions": [".csv", ".tsv", ".json", ".xlsx"],
        "title": "Open with DataCanvas"
      }
    ]
  },
  "logo_url": "https://raw.githubusercontent.com/RanuK12/rk-mcp-datacanvas/main/icon.png",
  "contact_email": "soporte@ranuk.dev",
  "legal_info_url": "https://github.com/RanuK12/rk-mcp-datacanvas/blob/main/TERMS.md",
  "privacy_policy_url": "https://github.com/RanuK12/rk-mcp-datacanvas/blob/main/PRIVACY.md"
}
